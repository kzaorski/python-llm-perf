# Skopiuj do .env (`cp .env.example .env`) i ładuj: `set -a; source .env; set +a`.
# Wartości są deterministyczne — działają od razu z `docker compose up -d --wait`.

# --- porty hosta (unikalne dla tego kursu; wszystkie na 127.0.0.1) ---
APP_PORT=8060
APP_GUNICORN_PORT=8062
WORKER_METRICS_PORT=8063
MOCK_LLM_PORT=8061
GRAFANA_PORT=3060
OTLP_GRPC_PORT=4367
OTLP_HTTP_PORT=4368
PROMETHEUS_PORT=9196
PYROSCOPE_PORT=4060
REDIS_PORT=6460
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- LLM: domyślnie atrapa (zgodna z Messages API Anthropic) ---
LLM_BASE_URL=http://127.0.0.1:8061
# zapasowy dostawca (ta sama atrapa, osobne limity): http://127.0.0.1:8061/b
LLM_FALLBACK_BASE_URL=http://127.0.0.1:8061/b
LLM_API_KEY=mock-key
LLM_MODEL=claude-haiku-5-5

# --- prawdziwy Claude: OPCJONALNIE, tylko ćwiczenia porównawcze (koszt w nagłówku ćwiczenia) ---
# Uwaga: nie ustawiaj globalnie ANTHROPIC_BASE_URL — SDK czyta ją z env i skieruje ruch gdzie indziej.
ANTHROPIC_API_KEY=

# --- atrapa LLM (wartości startowe kontenera; w locie: PATCH /admin/config) ---
MOCK_SEED=20261031
MOCK_TTFT_MEDIAN_MS=450
MOCK_TOKENS_PER_S=250
MOCK_RPM=4000
MOCK_ITPM=2000000
MOCK_OTPM=400000
MOCK_CAPACITY=64
MOCK_OVERLOAD_QUEUE=256
# Wywołania wielominutowe (60–300 s): domyślnie wyłączone; włączaj profilem w locie, np.
#   curl -X POST 127.0.0.1:8061/admin/profile/mieszany   (dlugi-ttft | dlugi-stream | pauzy | dlugi-ttft-ping)
# albo per żądanie nagłówkami x-mock-ttft-ms / x-mock-total-s / x-mock-output-tokens.
# Pamiętaj: k6 ma domyślny timeout żądania 60 s — w testach minutowych ustaw params.timeout.
MOCK_LONG_P=0

# --- Redis / kolejka ---
REDIS_URL=redis://127.0.0.1:6460/0

# --- OpenTelemetry (OTLP/HTTP do grafana/otel-lgtm) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4368
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=claims-assistant
# natywne spany SDK anthropic (anthropic.messages.create, atrybuty gen_ai.*) — w tym kursie WŁĄCZONE
ANTHROPIC_OPEN_TELEMETRY=true
PYROSCOPE_URL=http://127.0.0.1:4060

# --- k6 (kontener) widzi aplikację na hoście przez host.docker.internal ---
K6_APP_URL=http://host.docker.internal:8060
