# Copy to .env (`cp .env.example .env`) and load it: `set -a; source .env; set +a`.
# The values are deterministic — they work right away with `docker compose up -d --wait`.

# --- host ports (unique to this course; all on 127.0.0.1) ---
APP_PORT=8060
APP_GUNICORN_PORT=8062
WORKER_METRICS_PORT=8063
MOCK_LLM_PORT=8061
GRAFANA_PORT=3060
OTLP_GRPC_PORT=4367
OTLP_HTTP_PORT=4368
PROMETHEUS_PORT=9196
PYROSCOPE_PORT=4060
REDIS_PORT=6460
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- LLM: the mock by default (compatible with the Anthropic Messages API) ---
LLM_BASE_URL=http://127.0.0.1:8061
# fallback provider (the same mock, separate limits): http://127.0.0.1:8061/b
LLM_FALLBACK_BASE_URL=http://127.0.0.1:8061/b
LLM_API_KEY=mock-key
LLM_MODEL=claude-haiku-5-5

# --- real Claude: OPTIONAL, comparison exercises only (cost in the exercise header) ---
# Note: do not set ANTHROPIC_BASE_URL globally — the SDK reads it from the env and would send traffic elsewhere.
ANTHROPIC_API_KEY=

# --- mock LLM (container startup values; at runtime: PATCH /admin/config) ---
MOCK_SEED=20261031
MOCK_TTFT_MEDIAN_MS=450
MOCK_TOKENS_PER_S=250
MOCK_RPM=4000
MOCK_ITPM=2000000
MOCK_OTPM=400000
MOCK_CAPACITY=64
MOCK_OVERLOAD_QUEUE=256
# Multi-minute calls (60–300 s): off by default; switch them on at runtime with a profile, e.g.
#   curl -X POST 127.0.0.1:8061/admin/profile/mixed   (long-ttft | long-stream | pauses | long-ttft-ping)
# or per request with the x-mock-ttft-ms / x-mock-total-s / x-mock-output-tokens headers.
# Remember: k6 has a default request timeout of 60 s — set params.timeout in minute-long tests.
MOCK_LONG_P=0

# --- Redis / task queue ---
REDIS_URL=redis://127.0.0.1:6460/0

# --- OpenTelemetry (OTLP/HTTP to grafana/otel-lgtm) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4368
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=claims-assistant
# native spans of the anthropic SDK (anthropic.messages.create, gen_ai.* attributes) — ENABLED in this course
ANTHROPIC_OPEN_TELEMETRY=true
PYROSCOPE_URL=http://127.0.0.1:4060

# --- k6 (container) reaches the app on the host through host.docker.internal ---
K6_APP_URL=http://host.docker.internal:8060
